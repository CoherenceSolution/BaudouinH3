# Copiez ce fichier en .env et remplissez avec les valeurs de la console Firebase
# (Paramètres du projet > Vos applications > Configuration du SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mettre à true pour utiliser les émulateurs locaux (npm run emulators)
VITE_USE_EMULATORS=false
