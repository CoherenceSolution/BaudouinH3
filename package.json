{
  "name": "baudouin-h3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test scripts/calendar/*.test.mjs",
    "verify": "npm run typecheck && npm test && vite build",
    "verify:e2e": "bash scripts/e2e.sh",
    "verify:all": "npm run verify && npm run verify:e2e",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-baudouin-h3",
    "deploy": "npm run build && firebase deploy",
    "sync:calendar": "node scripts/calendar/sync.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.45.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
