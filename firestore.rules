rules_version = '2';

// Baudouin H3 — règles de sécurité Firestore
//
// Modèle de confiance :
//  - Membres publics : connexion anonyme Firebase, identité déclarative (nom choisi dans la liste).
//    Ils peuvent créer/modifier des tickets de vote, des "coups de cœur", et piloter la lecture (orateur).
//  - Admin : compte e-mail + mot de passe, rôle 'admin' dans staff/{uid}. Gère les droits.
//  - Secrétaires : joueurs marqués role = 'secretary' par l'admin. Pour écrire, ils ouvrent avec un
//    code PIN commun un compte technique partagé (staff/{uid}, role 'secretary') : la base reste
//    verrouillée pour quiconque n'a pas le code.
//    Seul le staff peut écrire joueurs, matchs, amendes, buts, statistiques.
//  - La coum (mise commune d'un match) est visible par tous, encaissée par le staff uniquement.
//  - Le journal d'activité est en ajout seul.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return isStaff() && staffDoc().data.role == 'admin';
    }

    function bootstrapDone() {
      return exists(/databases/$(database)/documents/config/bootstrap);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function onlyChangesAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ---- Configuration / première installation ----
    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.claimedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Paramètres (libellés des catégories…) ----
    match /config/settings {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Accès secrétaires : compte technique partagé, ouvert par le code PIN fixé par l'admin ----
    match /config/secretaryAccess {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Comptes staff ----
    match /staff/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      // Premier admin : créé par le compte e-mail qui réclame le bootstrap.
      allow create: if (signedIn() && request.auth.uid == uid && !bootstrapDone()
                        && request.resource.data.role == 'admin')
                    || isAdmin();
      // L'admin gère tout ; un membre du staff peut seulement relier son propre compte à un joueur.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && onlyChanges(['playerId']));
      allow delete: if isAdmin();
    }

    // ---- Joueurs : le champ « role » (droits de secrétaire) est réservé à l'admin ----
    match /players/{playerId} {
      allow read: if signedIn();
      allow create: if (isStaff() || (signedIn() && !bootstrapDone()))
                    && (!('role' in request.resource.data) || request.resource.data.role == null || isAdmin());
      allow update: if isStaff() && (!onlyChangesAny(['role']) || isAdmin());
      allow delete: if isStaff();
    }

    // ---- Matchs ----
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      // Le staff modifie tout ; l'orateur (anonyme) ne touche qu'au cycle de vie de la lecture.
      allow update: if isStaff()
                    || (signedIn() && onlyChanges(['status', 'speakerName', 'speakerUid', 'readingStartedAt', 'closedAt', 'updatedAt']));
    }

    // ---- Tickets de vote : id = <matchId>_<authorPlayerId> ----
    match /tickets/{ticketId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.matchId is string;
      allow delete: if isStaff();
    }

    // ---- Coups de cœur : id = <matchId>_<voterPlayerId>_<category> ----
    match /likes/{likeId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // ---- Buts (avec passeur) ----
    match /goals/{goalId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- La coum : mise commune de chaque match ----
    // Tout le monde voit qui a coumé ; seul le staff (trésorier) encaisse, marque les absents et recoume.
    match /coums/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Amendes ----
    match /fineTypes/{id} {
      allow read: if signedIn();
      allow create: if isStaff() || (signedIn() && !bootstrapDone());
      allow update, delete: if isStaff();
    }

    match /fines/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Statistiques personnalisées ----
    match /statCategories/{id} {
      allow read: if signedIn();
      allow create: if isStaff() || (signedIn() && !bootstrapDone());
      allow update, delete: if isStaff();
    }

    match /statEntries/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Journal d'activité (ajout seul) ----
    match /activity/{id} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
